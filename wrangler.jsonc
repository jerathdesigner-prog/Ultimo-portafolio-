{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jerathmoreira-cms",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "triggers": { "crons": ["0 3 * * *"] },
  "build": {
    "command": "bun run build:site",
    "watch_dir": "src/app"
  },
  "assets": {
    "directory": "./dist-site/browser",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ADMIN_USER": "jerath"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jerathmoreira-db",
      "database_id": "5c85b6dc-31fc-44f8-9cbb-0aeb470fef0c"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "jerathmoreira-media"
    }
  ]
}
